{
  "name": "vien-heritage-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:check": "node scripts/check-database.mjs",
    "media:migrate": "node scripts/migrate-media.mjs",
    "media:check": "node --experimental-strip-types scripts/check-media.mjs",
    "admin:grant": "node scripts/grant-admin.mjs",
    "test:modals": "node --experimental-strip-types --test scripts/modal-dialog.test.mjs",
    "progress:migrate": "node scripts/migrate-progress.mjs",
    "community:migrate": "node scripts/migrate-community.mjs",
    "community:check": "node --experimental-strip-types scripts/check-community.mjs",
    "progress:check": "node --experimental-strip-types scripts/check-progress.mjs",
    "auth:setup": "node scripts/setup-auth-env.mjs",
    "auth:migrate": "node --experimental-strip-types scripts/migrate-auth.mjs",
    "auth:check": "node --experimental-strip-types scripts/check-auth.mjs",
    "auth:check:web": "node --experimental-strip-types scripts/check-auth.mjs --web",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "predev": "node scripts/build-styles.mjs && node scripts/migrate-progress.mjs && node scripts/migrate-community.mjs && node scripts/migrate-media.mjs",
    "prebuild": "node scripts/build-styles.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "better-auth": "^1.7.11",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
